# ── Kisaniyat API environment ────────────────────────────────────
NODE_ENV=development
PORT=4000

# Database (also read by @kisaniyat/database)
DATABASE_URL="file:../../packages/database/prisma/dev.db"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS (comma-separated origins)
CORS_ORIGIN="http://localhost:5173"

# Cron automation (set false to disable scheduled sync)
ENABLE_CRON=true

# ── Optional external integrations (features fall back to mocks) ──
OPENAI_API_KEY=
GEMINI_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=
