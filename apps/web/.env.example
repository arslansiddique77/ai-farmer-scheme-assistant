# ── Frontend environment variables ──────────────────────────────
# Leave VITE_API_URL blank to run the frontend standalone with the
# bundled mock data layer. Set it to your backend URL to use real APIs.

# VITE_API_URL=http://localhost:4000/api

# Optional public keys (only if you wire real client-side integrations)
# VITE_MAPS_KEY=
